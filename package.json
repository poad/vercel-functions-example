{
  "name": "vercel-functions-example",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "test": "vitest run",
    "deploy:preview": "vercel deploy --prebuilt",
    "deploy": "vercel",
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "pnpm run --parallel /^.*:check$/",
    "lint-fix": "pnpm run /^.*:fix$/"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@hono/zod-validator": "^0.9.1",
    "@neondatabase/serverless": "^1.2.1",
    "flowbite": "^4.0.2",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/vite-plugin": "^3.0.1",
    "@solidjs/web": "^2.0.3",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "autoprefixer": "^10.7.0",
    "eslint-plugin-solid": "^0.20.0",
    "jsdom": "^31.0.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "postcss": "^8.5.33",
    "solid-js": "^2.0.3",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vercel": "^65.16.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.13.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.x"
  }
