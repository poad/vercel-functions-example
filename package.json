{
  "name": "vercel-functions-example",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "test": "vitest run",
    "deploy:preview": "vercel deploy --prebuilt",
