{
  "name": "vercel-functions-example",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "test": "vitest run",
    "deploy:preview": "vercel deploy --prebuilt",
    "deploy": "vercel",
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "pnpm run --parallel /^.*:check$/",
    "lint-fix": "pnpm run /^.*:fix$/"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@hono/zod-validator": "^0.9.1",
    "@neondatabase/serverless": "^1.2.0",
    "flowbite": "^4.0.2",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "autoprefixer": "^10.6.2",
    "eslint-plugin-solid": "^0.18.1",
    "jsdom": "^31.0.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.92.0",
    "postcss": "^8.5.32",
    "solid-js": "^1.9.18",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vercel": "~58.4.4",
    "vite": "^8.3.6",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.13.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.x"
  }
}
